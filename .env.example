# Copie para .env (no computador) ou cadastre em Vercel › Project › Settings › Environment Variables.
APP_NAME=CMV Certo
# Endereço público do app (usado nos e-mails). Ex.: https://ficha-certa.vercel.app
APP_URL=http://localhost:3000

# Banco Postgres. Na Vercel, conectar o Neon (Storage) preenche DATABASE_URL sozinho.
# No computador pode ficar vazio: o app usa um Postgres embutido gravando em ./data/pg
DATABASE_URL=

# Conta do painel administrativo (/admin). Criada no primeiro acesso.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha

# Segredo do lembrete diário (Vercel Cron). Use um texto aleatório longo.
CRON_SECRET=

# Valor mensal do plano Pro (R$)
PRO_PRICE=25
# Oferta de boas-vindas: preço dos primeiros 30 dias para quem nunca assinou o Pro (R$)
PRO_PRICE_OFERTA=10

# WhatsApp do suporte (com DDI e DDD, só números). O usuário paga e renova o Pro por aqui.
SUPORTE_WHATSAPP=5515988305442

# E-mail (opcional): lembretes de renovação e recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CMV Certo <no-reply@seudominio.com.br>"
